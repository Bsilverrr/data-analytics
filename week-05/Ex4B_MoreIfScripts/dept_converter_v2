dept_code = 10

match dept_code:
    case 1:
        dept_name = 'Marketing'
    case 5:
        dept_name = 'Human Resources'
    case 10:
        dept_name = 'Accounting'
    case 12:
        dept_name = 'Legal'
    case 18:
        dept_name = 'IT'
    case 20:
        dept_name = 'Customer Relations'
    case _:
        dept_name = 'Unknown department code'

print(f'Department code {dept_code} is {dept_name}')